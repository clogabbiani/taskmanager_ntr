# TASKME NTR — environment variables.
# Copy to .env.local (Next.js) and .env (scripts / drizzle-kit). Never commit real values.

# --- Supabase: browser-safe, also set on Vercel (Production + Preview) ---------
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → anon (legacy) or publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-only secrets — NEVER on the client, NOT needed on Vercel in M0 --
# Used only by scripts/import-jira.ts (M4), webhooks and the email job (M3).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection for drizzle-kit migrate and pnpm db:seed.
# Use the "Session pooler" URI (IPv4-friendly): Connect → Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Seed --------------------------------------------------------------------
# Comma separated. Unset = ntrbiosensors.com (Q1). Set to empty to allow-list mapped emails only.
# SEED_ALLOWED_DOMAINS=ntrbiosensors.com

# --- Google OAuth --------------------------------------------------------------
# Configured in the Supabase dashboard (Authentication → Providers → Google),
# not read by the app. Kept here as a reminder of where they live.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Resend (M3) ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- Jira import (M4, project PN) ----------------------------------------------
JIRA_BASE_URL=https://claudiogabbiani.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- E2E (optional) ------------------------------------------------------------
# Run Playwright against a deployed URL instead of a local dev server.
E2E_BASE_URL=
